{% comment %}
  Shopify-compatible LaraPush web push.
  Uses the LaraPush CDN popup script for custom branded prompts.
  Service worker is registered under /apps/larapush/ (Shopify app proxy scope).
{% endcomment %}
<script>
(function () {
  if (window.__larapushShopifyLoaded) return;
  window.__larapushShopifyLoaded = true;

  if (window.top !== window.self) return;
  if (window.location.pathname.indexOf('/web-pixels@') === 0) return;

  // Fetch config and load CDN script in parallel to minimise latency.
  var configPromise = fetch('/apps/larapush/config.json', {
    credentials: 'same-origin',
    headers: { 'ngrok-skip-browser-warning': '1' }
  }).then(function (res) { return res.json(); });

  var scriptPromise = new Promise(function (resolve, reject) {
    var s = document.createElement('script');
    s.src = 'https://cdn.larapush.com/scripts/larapush-popup-5.0.0.min.js';
    s.onload = resolve;
    s.onerror = reject;
    document.head.appendChild(s);
  });

  Promise.all([configPromise, scriptPromise])
    .then(function (results) {
      var data = results[0];
      if (!data || !data.success) {
        console.warn('[LaraPush] Not connected or config unavailable.', data);
        return;
      }
      if (typeof LaraPush !== 'function') {
        console.warn('[LaraPush] CDN script did not expose LaraPush.');
        return;
      }
      new LaraPush(data.options, data.popup_data);
    })
    .catch(function (err) {
      console.warn('[LaraPush] Embed failed:', err);
    });
})();
</script>

{% schema %}
{
  "name": "LaraPush Subscribe",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Enable after connecting the LaraPush app in Shopify Admin. Shows a custom branded push notification prompt configured in your LaraPush panel."
    }
  ]
}
{% endschema %}
